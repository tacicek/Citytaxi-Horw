# Vorlage nur mit Platzhaltern — echte Secrets in .env.local (nicht committen).
# Wenn Sie hier versehentlich echte Keys eingetragen haben: alle betroffenen Keys/Passwörter rotieren.

# ── Domain ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DOMAIN=citytaxihorw.ch

# ── Google Maps (optional: Abholort/Ziel Autocomplete auf /booking) ─────────
# Schlüssel in Google Cloud auf HTTP-Referrer beschränken (localhost + Live-Domain).
# APIs: „Maps JavaScript API“ + „Places API“ aktivieren.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Contact Form (Booking & Contact endpoints) ───────────────────────────────
CONTACT_FORM_TO=info@citytaxihorw.ch
BOOKING_FORM_TO=info@citytaxihorw.ch

# ── Taxi booking: E-Mail (Resend) ────────────────────────────────────────────
# https://resend.com — Domain verifizieren, dann From-Adresse nutzen.
# In Production: Resend ODER BOOKING_WEBHOOK_URL setzen (sonst lehnt /api/booking ab).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
BOOKING_EMAIL_FROM="Citytaxi Horw <bookings@deine-domain.ch>"
BOOKING_EMAIL_DISPATCH=info@citytaxihorw.ch
# Optional: Reply-To für Antworten an die Zentrale statt Kunde
# BOOKING_EMAIL_REPLY_TO=info@citytaxihorw.ch

# Optional: Zapier / Make / Slack eingehender Webhook — JSON-Body wie BookingPayload
# BOOKING_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...

# ── SMTP (for contact/booking email notifications) ───────────────────────────
SMTP_HOST=smtp.example.ch
SMTP_PORT=587
SMTP_USER=noreply@example.ch
SMTP_PASS=your-secure-password
SMTP_SECURE=false
SMTP_FROM="City Taxi Horw <noreply@example.ch>"

# ── Optional: WhatsApp Business API ─────────────────────────────────────────
# WHATSAPP_API_TOKEN=your-token
